DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=faceclass
DB_USER=USUARIO_DO_MYSQL
# Deixe DB_PASSWORD="" apenas se este usuario do MySQL ja tiver senha vazia.
# A senha e passada diretamente: @ nao precisa virar %40.
DB_PASSWORD="SENHA_DO_MYSQL"

APP_SECRET=COLE_A_CHAVE_GERADA
APP_HTTPS=false

FACE_ENCRYPTION_KEY=COLE_A_CHAVE_FACIAL_GERADA
FACE_THRESHOLD=0.5

ESCOLA_LATITUDE=-23.4713832
ESCOLA_LONGITUDE=-46.6351309
ESCOLA_RAIO_METROS=100
GPS_PRECISAO_MAX_METROS=100
HORARIO_SAIDA=12:10

# Gmail e opcional para iniciar o site. Configure depois, somente no .env.
# Sem SMTP, os avisos ficam pendentes ate iniciar o processador com credenciais.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
